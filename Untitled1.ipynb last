      "source": [
        "# 1) Droite de régression\n",
        "pente, ordonnee = np.polyfit(conc, absorbance, 1)\n",
        "\n",
        "# 2) Coefficient de détermination R²\n",
        "A_calc = pente * conc + ordonnee                # absorbance calculée par la droite\n",
        "ss_res = np.sum((absorbance - A_calc) ** 2)     # écarts entre mesure et droite\n",
        "ss_tot = np.sum((absorbance - np.mean(absorbance)) ** 2)  # écarts entre mesure et moyenne\n",
        "R2 = 1 - ss_res / ss_tot\n",
        "\n",
        "# 3) Affichage\n",
        "print(f\"pente = {pente:.4f} | ordonnee = {ordonnee:.4f} | R² = {R2:.4f}\")"
      ],
